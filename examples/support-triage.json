{
  "id": "support-triage",
  "name": "Support triage",
  "mode": "custom",
  "router_model": "laya",
  "routes": [
    {"label": "billing", "description": "invoices, payments, refunds, double charges", "examples": ["I was charged twice"],
     "action": "forward", "model_id": "CHANGE-ME", "system_prompt": "You are a billing support agent. Be precise about amounts and dates.", "response_text": "", "color": "#2E9E6B"},
    {"label": "technical", "description": "bugs, outages, system errors", "examples": ["The app crashes on login"],
     "action": "forward", "model_id": "CHANGE-ME", "system_prompt": "You are a technical support engineer. Ask for logs when needed.", "response_text": "", "color": "#2F6FDE"},
    {"label": "human", "description": "needs a person", "examples": [],
     "action": "respond", "model_id": null, "system_prompt": "", "response_text": "I've passed this to a teammate who will reply shortly.", "color": "#D1483A"}
  ],
  "fallback_label": "technical",
  "min_confidence": 0.0,
  "signals": [
    {"name": "urgency", "type": "score", "instructions": "How urgent is this?", "criteria": ["not urgent", "soon", "blocking"]},
    {"name": "churn_risk", "type": "noul", "instructions": "Does the user threaten to cancel or leave?", "criteria": null}
  ],
  "rules": [
    {"signal": "churn_risk", "op": "gte", "value": "0.7", "route_label": "human"}
  ]
}
